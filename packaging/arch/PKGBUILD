# Maintainer: dansc89
pkgname=glyph-pdf-git
pkgver=r0.0000000
pkgrel=1
pkgdesc="Native Linux PDF drawing-set editor inspired by Drawbridge"
arch=('x86_64')
url="https://github.com/dansc89/Glyph"
license=('MIT')
depends=('gcc-libs' 'glibc' 'fontconfig' 'libx11' 'libxcb' 'libxcursor' 'libxi' 'libxinerama' 'libxkbcommon' 'libxkbcommon-x11' 'libxrandr' 'mesa' 'vulkan-icd-loader' 'wayland')
makedepends=('desktop-file-utils' 'git' 'pkgconf' 'rust')
provides=('glyph-pdf')
conflicts=('glyph-pdf')
source=('git+https://github.com/dansc89/Glyph.git')
sha256sums=('SKIP')

pkgver() {
  cd Glyph
  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

build() {
  cd Glyph
  cargo build --release --locked
}

check() {
  cd Glyph
  cargo test --locked
  desktop-file-validate packaging/linux/glyph.desktop
}

package() {
  cd Glyph
  install -Dm755 target/release/glyph "$pkgdir/usr/lib/glyph/glyph-bin"
  install -Dm755 packaging/linux/glyph-launcher "$pkgdir/usr/bin/glyph"
  install -Dm644 packaging/linux/glyph.desktop "$pkgdir/usr/share/applications/glyph.desktop"
  install -Dm644 packaging/linux/glyph.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/glyph.svg"
  install -Dm644 README.md "$pkgdir/usr/share/doc/glyph/README.md"
}
